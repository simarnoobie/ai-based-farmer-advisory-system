# ─────────────────────────────────────────────────────────────────────────────
# Docker Compose secrets — copy this file to .env in the project root
#
#   cp .env.docker.example .env
#
# .env is gitignored. Never commit the filled-in version.
# ─────────────────────────────────────────────────────────────────────────────

# MySQL root password — used by both the mysql container and the backend
MYSQL_ROOT_PASSWORD=farmer_ai_change_me

# JWT signing secret — generate one: python3 -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=replace-with-a-long-random-string

# Groq API key (leave blank to use Ollama running on your host)
# Free key: https://console.groq.com → API Keys → Create API Key
GROQ_API_KEY=

# Groq model (only used if GROQ_API_KEY is set)
GROQ_MODEL=llama3-8b-8192

# AWS S3 — only needed if NOT using the local volume mount for the model
S3_BUCKET=
S3_MODEL_KEY=models/trained_farmer_model.h5
